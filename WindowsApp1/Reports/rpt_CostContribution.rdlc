  <Code>Dim totalDebit as Decimal
Dim totalCredt as Decimal

Public Function AddDebit(Amount as Decimal ) as Decimal 
	totalDebit = totalDebit + Amount
	Return Amount 
End Function

Public Function AddCredit(Amount as Decimal ) as Decimal 
	totalCredt = totalCredt +  Amount
	Return Amount 
End Function

Public Function GetDebit_Total()
	Return totalDebit
End Function

Public Function GetCredit_Total()
	Return totalCredt 
End Function

</Code>
