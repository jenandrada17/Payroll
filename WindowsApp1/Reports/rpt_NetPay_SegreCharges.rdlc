                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(Fields!COMPANY.Value = "PHOTO" oR Fields!PLUS.Value = "PHOTO" , Fields!PLUS.Value, 
Fields!COMPANY.Value = "P&amp;G UY" oR Fields!PLUS.Value = "P&amp;G UY" , "P&amp;G UY SONS, INC.", 
Fields!COMPANY.Value = "DALTON" oR Fields!PLUS.Value = "DALTON" , "DALTON PAWNSHOP &amp; JEWELRY INC.", 
Fields!COMPANY.Value = "PERFECOM" oR Fields!PLUS.Value = "PERFECOM" , "PERFECOM",
Fields!PLUS.Value = "PGC", "GENSAN PERFECT IMAGE", 
Fields!PLUS.Value = "PTU", "PTU REALTY")</Value>
                                  <Style>
                                    <FontFamily>Berlin Sans FB Demi</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Medium</FontWeight>
                                  </Style>
                                </TextRun>
