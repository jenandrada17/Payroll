  <Code>Function TitleCase(str as String) as String

		Dim toLower, toProper as String
		toLower = str.ToLower()

		Dim cultureInfo As New System.Globalization.CultureInfo("en-US")
		toProper = cultureInfo.TextInfo.ToTitleCase(toLower)

	 Return toProper 
