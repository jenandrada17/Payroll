  <Code>Function Photo_Perfecom(one as Integer, two as Integer, three as Integer ) as String

	Dim sum as Integer = one + two  + three 
	Dim percent as String = FormatPercent(one / sum , 2, TriState.False)
	Return percent 
End Function

Function Photo_GHS_3G(one as Integer, two as Integer, three as Integer , four as Integer ) as String

	Dim sum as Integer = one + two  + three  + four
	Dim percent as String = FormatPercent(one / sum , 2, TriState.False)
	Return percent 
End Function
</Code>
