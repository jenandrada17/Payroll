Convert.ToInt16(Fields!WAVE_BB.Value) + Convert.ToInt16(Fields!WAVE_HO.Value) +
Convert.ToInt16(Fields!PGC.Value) + Convert.ToInt16(Fields!LEASING.Value)</Value>
