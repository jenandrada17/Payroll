                      <CellContents>
                        <Textbox Name="TOTALS_EE">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=CInt(Fields!DALTON_BB.Value) + CInt(Fields!DALTON_HO.Value) +
CInt(Fields!GENSANPERFECT_BB.Value) + CInt(Fields!GENSANPERFECT_HO.Value) +
CInt(Fields!JRPHOTO_BB.Value) + CInt(Fields!JRPHOTO_HO.Value) +
CInt(Fields!DAVAOP_BB.Value) + CInt(Fields!DAVAOP_HO.Value) +
CInt(Fields!PERFECOM_BB.Value) + CInt(Fields!PERFECOM_HO.Value) +
CInt(Fields!G3_BB.Value) + CInt(Fields!G3_HO.Value) +
CInt(Fields!Seven11_ROX_BB.Value) + CInt(Fields!Seven11_ROX_HO.Value) +
CInt(Fields!Seven11_POL_BB.Value) + CInt(Fields!Seven11_POL_HO.Value) +
CInt(Fields!COMI_BB.Value) + CInt(Fields!COMI_HO.Value) +
CInt(Fields!PBA_BB.Value) + CInt(Fields!PBA_HO.Value) +
CInt(Fields!KTV_BB.Value) + CInt(Fields!KTV_HO.Value) +
CInt(Fields!WAVE_BB.Value) + CInt(Fields!WAVE_HO.Value)</Value>
                                  <Style>
                                    <FontFamily>Berlin Sans FB</FontFamily>
                                    <FontSize>8pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
