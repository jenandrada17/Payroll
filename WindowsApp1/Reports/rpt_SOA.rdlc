                        <TablixCell />
                        <TablixCell>
                          <CellContents>
                            <Textbox Name="Textbox379">
                              <CanGrow>true</CanGrow>
                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Switch(
    Parameters!paramCompany.Value = "DALTON", "Lynton Y. Uy",
	Parameters!paramCompany.Value = "P&amp;G UY", "Lynton Y. Uy",
	InStr(Parameters!paramCompany.Value, "Dalton") &gt; 0, "Lynton Y. Uy", 
	InStr(Parameters!paramCompany.Value, "GHS/P&amp;G UY") &gt; 0, "Lynton Y. Uy",
	InStr(Parameters!paramCompany.Value, "PGC") &gt; 0, "Lynton Y. Uy",
    
	Parameters!paramCompany.Value = "PHOTO", "Darren Y. Uy",
	Parameters!paramCompany.Value = "PERFECOM", "Darren Y. Uy",
	InStr(Parameters!paramCompany.Value, "Photo") &gt; 0, "Darren Y. Uy",
	InStr(Parameters!paramCompany.Value, "Perfecom") &gt; 0, "Darren Y. Uy",
    
	Parameters!paramCompany.Value = "HER GRACE", "Godwin Lance Y. Uy",
    True, ""
)</Value>
                                      <Style>
                                        <FontSize>9pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Left</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <rd:DefaultName>Textbox343</rd:DefaultName>
                              <Style>
                                <Border>
                                  <Style>None</Style>
                                </Border>
                                <VerticalAlign>Middle</VerticalAlign>
                                <PaddingLeft>2pt</PaddingLeft>
                                <PaddingRight>2pt</PaddingRight>
                                <PaddingTop>2pt</PaddingTop>
                                <PaddingBottom>2pt</PaddingBottom>
                              </Style>
                            </Textbox>
                            <ColSpan>2</ColSpan>
                            <rd:Selected>true</rd:Selected>
                          </CellContents>
                        </TablixCell>
