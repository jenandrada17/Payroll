  <Code>Dim public totalsGJR as Double
Dim public totalsDAVAO as Double
Dim public totalsDALTON as Double
Dim public totalsPERFECOM as Double
Dim public totalsPG as Double
Dim public grandTotal as Double

Public Function AddTotal(Amount AS String, name as String) AS String

	if name = "GJR" then
		totalsGJR = totalsGJR + CDbl(Amount)
	elseif name = "DAVAO" then		
		totalsDAVAO = totalsDAVAO + CDbl(Amount)
	elseif name = "DALTON" then		
		totalsDALTON = totalsDALTON + CDbl(Amount)
	elseif name = "PERFECOM" then		
		totalsPERFECOM = totalsPERFECOM + CDbl(Amount)
	elseif name = "PG" then		
		totalsPG = totalsPG + CDbl(Amount)
	end if
                
                return Amount 
 
End Function
 
Public Function GetTotal_GJR()
                return totalsGJR.ToString("n")
End Function


Public Function GetTotal_DAVAO()
                return totalsDAVAO.ToString("n")
End Function

Public Function GetTotal_DALTON()
                return TotalsDALTON.ToString("n")
End Function

Public Function GetTotal_PERFECOM()
                return totalsPERFECOM.ToString("n")
End Function

Public Function GetTotal_PG()
                return totalsPG.ToString("n")
End Function

Public Function AddGrandTotal(Amount AS String) AS String	
		grandTotal = grandTotal + CDbl(Amount)
                return Amount 
End Function

Public Function GetGrand_Total()
                return grandTotal .ToString("n")
End Function

</Code>
